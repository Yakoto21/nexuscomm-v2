# Exemplo de configuração de ambiente para o NexusComm V2
# NUNCA insira credenciais reais neste arquivo versionado no Git!

# Porta de execução do servidor HTTP / Socket.IO
PORT=3333

# String de conexão com o PostgreSQL (Supabase / Render / Local)
DATABASE_URL="postgresql://usuario:senha@host:5432/banco"

# Chave secreta de alta entropia para assinatura e verificação de tokens JWT
JWT_SECRET="insira_uma_chave_secreta_aleatoria_aqui_minimo_256_bits"

# (Opcional) Chaves de API do Supabase Storage
SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sua_chave_service_role_aqui"

# (Opcional) Origens CORS adicionais permitidas (separadas por vírgula)
ALLOWED_ORIGINS="http://localhost:3333,https://nexuscomm-v2.onrender.com"
